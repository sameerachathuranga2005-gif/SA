# ==============================================================================
# Server Environment Configuration
# ==============================================================================

# Server Port (7860 for Hugging Face Spaces, auto-assigned by cloud hosts, or default 7860)
PORT=7860

# Environment Mode (development | production)
NODE_ENV=production

# Frontend Client URL allowed by CORS (Vercel deployment domain)
# Supports single URL, comma-separated URLs, or localhost for local testing
# Example: https://your-project.vercel.app,https://your-custom-domain.com
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas cloud URI or local mongod)
# In-memory reactive store is used automatically if offline/unreachable
MONGODB_URI=mongodb://localhost:27017/superapp

# JWT Authentication Secret & Token Expiry
JWT_SECRET=superapp_production_secret_key_change_in_prod_2025_secure
JWT_EXPIRES_IN=7d
